# Salin ke .env.local untuk pengembangan lokal. JANGAN commit file .env.local.
# Di Vercel, isi tiga variabel ini di Project Settings > Environment Variables.

# --- Pilihan 1: Groq (gratis) - key di https://console.groq.com/keys ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=isi_api_key_anda
LLM_MODEL=llama-3.3-70b-versatile

# --- Pilihan 2: Google Gemini (gratis) - key di https://aistudio.google.com/apikey ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# --- Pilihan 3: OpenRouter (model berlabel :free) - key di https://openrouter.ai/keys ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Model cadangan (opsional) ---
# Isi beberapa nama model, dipisah koma atau baris baru. Dicoba berurutan (maksimal 4):
# jika model pertama error, sibuk, kosong, atau lambat, model berikutnya dipakai otomatis.
# Model embedding/rerank/safety/audio otomatis dilewati. Jika kosong, dipakai LLM_MODEL.
# LLM_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Tool / MCP (opsional) ---
# Server MCP di /api/mcp aktif hanya jika token ini diisi. Buat dengan: openssl rand -hex 32
# MCP_AUTH_TOKEN=
# Izinkan chat memanggil tool di lib/tools.ts (model harus mendukung tool calling).
# Jika aktif, jawaban dikirim utuh (tidak bertahap).
# CHAT_TOOLS=true
